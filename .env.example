# Core GCP settings
MONITOR_PROJECT_ID=lcs-developer-483404
MONITOR_SOURCE_SERVICE=lcs-rag-app

# BigQuery logs dataset
MONITOR_BQ_DATASET=oura_navi_monitor
MONITOR_BQ_LOCATION=US

# Firestore chat storage
MONITOR_FIRESTORE_DATABASE=lcs-user-data
MONITOR_FIRESTORE_CHAT_COLLECTION=chat_users
MONITOR_FIRESTORE_USER_COLLECTION=monitor_users
MONITOR_FIRESTORE_LABEL_COLLECTION=monitor_labels
MONITOR_FIRESTORE_ADMIN_CHANGE_COLLECTION=monitor_admin_changes
MONITOR_FIRESTORE_EXPORT_COLLECTION=monitor_export_jobs
MONITOR_FIRESTORE_UNIQUE_CLAIM_COLLECTION=monitor_unique_claims

# Supplied from Secret Manager in Cloud Run; never commit the value.
MONITOR_IDENTITY_HMAC_KEY=

# Security
MONITOR_ADMIN_ALLOWLIST=2401145@tc.terumo.co.jp,2304371@tc.terumo.co.jp,0800781@tc.terumo.co.jp
# Exact Signed Header JWT Audience from the IAP-protected backend service.
MONITOR_IAP_AUDIENCE=
MONITOR_ALLOW_UNVERIFIED_LOCAL=false
MONITOR_CORS_ALLOWED_ORIGINS=

# Data horizon
MONITOR_DEFAULT_DAYS=7
MONITOR_RETENTION_DAYS=180
MONITOR_DATA_FRESHNESS_MINUTES=45
MONITOR_REFRESH_OVERLAP_MINUTES=120
MONITOR_REFRESH_DELAY_MINUTES=5
MONITOR_QUERY_MAXIMUM_BYTES=1073741824
MONITOR_FACT_RETENTION_DAYS=180
MONITOR_AGGREGATE_RETENTION_DAYS=365
MONITOR_ADMIN_CHANGE_RETENTION_DAYS=180
# Freeze this only after the pre-delete live inventory.
MONITOR_ANALYTICS_START_AT=

# App
MONITOR_TIMEZONE=Asia/Tokyo
MONITOR_LOG_LEVEL=INFO
